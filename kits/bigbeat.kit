# ToastedDrums kit: big beat. Same nine slots as mt240.kit (slot -> tile x=slot%3 y=slot/3)
# and the same toy-keyboard samples underneath -- but mutated, plus a synthesised sub kick.
#
# The measurements this is built from (tools/analyze_track.py on two Prodigy tracks):
#   half of all energy below 120 Hz; the bassline itself lives in 60-120 Hz; hats under 1%;
#   crest factor 9-12 dB, i.e. everything is squashed into a wall.
# So: a sine sub with a pitch drop for the kick, everything else pitched down and driven,
# and the hats kept small.
name BigBeat
voice 0 kick    255,40,0    synth:kick f0=48 sweep=130 decay=450 click=0.4 drive=3
voice 1 snare   255,200,0   ../toykeyboards/Keys (MT240)/individual drums/MT240_snare_med.wav pitch=0.85 drive=4 crush=9
voice 2 stick   255,0,120   ../toykeyboards/Keys (MT240)/individual drums/MT240_snare_sidetap.wav pitch=0.7 drive=3 crush=7
voice 3 hat     0,200,255   ../toykeyboards/Keys (MT240)/individual drums/MT240_hihat_closed.wav pitch=1.1 crush=8 gain=0.5
voice 4 ohat    0,255,160   ../toykeyboards/Keys (MT240)/individual drums/MT240_hihat_open.wav pitch=0.9 drive=2 gain=0.5
voice 5 cowbell 200,255,0   ../toykeyboards/Keys (MT240)/individual drums/MT240_cowbell.wav pitch=0.6 drive=5 crush=6
voice 6 tomlo   120,0,255   ../toykeyboards/Keys (MT240)/individual drums/MT240_electom_low.wav pitch=0.55 drive=4
voice 7 tomhi   200,80,255  ../toykeyboards/Keys (MT240)/individual drums/MT240_electom_high.wav pitch=0.7 drive=4 rev
voice 8 crash   255,255,255 ../toykeyboards/Keys (MT240)/individual drums/MT240_crash_long.wav pitch=0.8 drive=3 gain=0.7
